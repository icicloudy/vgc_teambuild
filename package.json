{
  "name": "champions-teambuilder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "HOST_ALL=1 vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:lan": "HOST_ALL=1 vite preview",
    "lint": "oxlint",
    "check": "tsx scripts/check-data.ts",
    "smoke": "node scripts/smoke.mjs",
    "smoke:mobile": "node scripts/mobile-check.mjs",
    "build:artifact": "tsc -b && vite build --config vite.artifact.config.ts && node scripts/make-artifact.mjs",
    "check:artifact": "node scripts/artifact-check.mjs"
  },
  "dependencies": {
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@smogon/calc": "^0.11.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.58.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "description": "Teambuilder, damage calculator and coach for Pok\u00e9mon Champions VGC"
}
